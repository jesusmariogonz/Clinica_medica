# Supabase — proyecto del consultorio (crear en supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca exponer al cliente. Solo usar en server actions/route handlers
# específicos (webhooks de pago, bitácora, URLs firmadas de Storage).
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Mercado Pago (opcional — feature flag hasta tener credenciales)
NEXT_PUBLIC_MP_ENABLED=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Resend (emails transaccionales)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Dra. Maggie Morales <no-reply@example.com>"
# Correo donde la Dra. recibe notificación de cada cita nueva (opcional,
# por defecto usa el correo de contacto de la clínica)
MEDICO_NOTIFICACION_EMAIL=sandramormart@gmail.com

# Cron de recordatorios (Vercel firma este valor automáticamente como
# header Authorization al invocar el cron definido en vercel.json)
CRON_SECRET=

# WhatsApp (botón flotante del sitio público)
NEXT_PUBLIC_WHATSAPP_NUMBER=528441602304

# URL pública del sitio (usada en emails/redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
